{
  "name": "dsh-mobile-remote-control",
  "version": "2.0.0",
  "description": "DeepSeek Harness 移动端远程控制插件：桌面端扫码配对，手机端实时查看与控制真实会话（任务列表、历史消息、流式输出、打断、模型切换、本轮文件改动审查）",
  "icon": "icon.svg",
  "type": "module",
  "main": "src/index.mjs",
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node test/verify-server.mjs && node test/host-bridge.test.mjs && node test/approval-bridge.test.mjs && node test/questions-bridge.test.mjs && node --test test/image-upload.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "mobile-web",
    "mobile",
    "local-network",
    "qr-code",
    "pwa",
    "cordis",
    "approval-forwarding"
  ],
  "author": "JUEMING-006",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JUEMING-006/dsh-mobile-remote-control.git"
  },
  "homepage": "https://github.com/JUEMING-006/dsh-mobile-remote-control",
  "bugs": {
    "url": "https://github.com/JUEMING-006/dsh-mobile-remote-control/issues"
  }
}
